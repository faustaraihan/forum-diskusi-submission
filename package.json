    "test": "vitest run",
    "e2e": "start-server-and-test \"npm run dev -- --port 4173 --strictPort\" http://127.0.0.1:4173 \"cypress run --browser electron\"",
    "e2e:open": "start-server-and-test \"npm run dev -- --port 4173 --strictPort\" http://127.0.0.1:4173 \"cypress open\"",
    "storybook": "storybook dev -p 6006 --host 127.0.0.1 --no-open",
    "build-storybook": "storybook build --disable-telemetry"
  },
  "dependencies": {
    "@reduxjs/toolkit": "2.13.0",
    "dompurify": "3.4.16",
    "react": "19.3.0",
    "react-dom": "19.3.0",
